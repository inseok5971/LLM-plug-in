#!/bin/bash
# 맥(macOS) 전용 원클릭 실행기
cd "$(dirname "$0")"

# 이전 프로세스가 남아있다면 깔끔하게 정리 후 시작
lsof -ti:8765 | xargs kill -9 2>/dev/null

echo "=========================================================="
echo " ⚡ AI 플러그인 스위치보드 미니 위젯을 실행합니다..."
echo " 종료하려면 이 터미널 창에서 Ctrl + C를 누르거나 창을 닫으세요."
echo "=========================================================="

python3 main.py
