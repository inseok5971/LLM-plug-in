#!/bin/bash
# 맥(macOS) 전용 원클릭 종료기
cd "$(dirname "$0")"

echo "=========================================================="
echo " 🛑 AI 플러그인 스위치보드 위젯을 종료합니다..."
echo "=========================================================="

lsof -ti:8765 | xargs kill -9 2>/dev/null

echo "✅ 스위치보드가 안전하게 종료되었습니다."
sleep 1
